  "processExamples": [
    {
      "id": "lee2013",
      "label": "Lee 2013 研究流程",
      "kind": "research-method",
      "note": "本活動四處理揮發物數據唯一對應此研究；未記載的小麥、壓榨或加熱排程不補入。",
      "sourceRefs": [
        "soy-source-lee2013"
      ],
      "stages": [
        {
          "id": "lee-prepare",
          "label": "浸泡與蒸製大豆",
          "summary": "本研究方法列大豆前處理，沒有列小麥。",
          "state": "含水固體大豆",
          "sourceRefs": [
            "soy-source-lee2013"
          ],
          "sourceLocation": "Methods / Materials and chemicals",
          "actions": [
            {
              "id": "lee-steam",
              "label": "蒸製大豆",
              "type": "physical-treatment",
              "explanation": "加熱處理原料；這一步不能改名為微生物發酵，也不據此宣告完全無菌。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            }
          ]
        },
        {
          "id": "lee-koji",
          "label": "製麴",
          "summary": "接 A. oryzae 製麴 44 h；自然酵母和乳酸菌也存在。",
          "state": "含水固體基質",
          "sourceRefs": [
            "soy-source-lee2013"
          ],
          "sourceLocation": "Introduction; Methods / Materials and chemicals",
          "actions": [
            {
              "id": "lee-enzymes",
              "label": "麴菌產生胞外酵素",
              "type": "enzyme-production",
              "explanation": "菌生長與產酵素是一種角色；酵素催化反應是另一種作用。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            },
            {
              "id": "lee-protein",
              "label": "蛋白質變成肽與胺基酸",
              "type": "hydrolysis",
              "explanation": "蛋白酶等催化水解；不把全部蛋白一次變成單一產物，也不由表中揮發物估水解率。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            }
          ]
        },
        {
          "id": "lee-brine",
          "label": "麴加入鹽液",
          "summary": "22% 鹽液、麴與鹽液 1:2；此方法句未說明比例基準。",
          "state": "鹽液與固體原料形成醪",
          "sourceRefs": [
            "soy-source-lee2013"
          ],
          "sourceLocation": "Methods / Materials and chemicals; Table 1",
          "actions": [
            {
              "id": "lee-mix",
              "label": "把麴與鹽液混合",
              "type": "handling",
              "explanation": "混合不是形成新胺基酸的化學反應。Table 1 四組樣品為 16% w/v 鹽，不能將 22% 鹽液直接套成醪或成品鹽度。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            }
          ]
        },
        {
          "id": "lee-ferment",
          "label": "三個月發酵",
          "summary": "四組比較額外接種；醪液發酵溫度未報。",
          "state": "含固形物的鹽液醪",
          "sourceRefs": [
            "soy-source-lee2013"
          ],
          "sourceLocation": "Introduction; Methods; Table 1",
          "actions": [
            {
              "id": "lee-continued-hydrolysis",
              "label": "麴來源酵素繼續水解",
              "type": "hydrolysis",
              "explanation": "酵素仍能作用，不等於產酵素黴菌此時仍在增殖；這篇沒有逐時活性收支。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            },
            {
              "id": "lee-products",
              "label": "微生物形成酸、醇等產物",
              "type": "metabolism",
              "explanation": "此處是角色概念。終點峰面積不識別唯一生產菌、實際通量、完整途徑或安全性。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            }
          ]
        },
        {
          "id": "lee-sample",
          "label": "終點樣品與量測",
          "summary": "樣品保存後，以兩種萃取法分析；每種萃取做三次。",
          "state": "研究取樣與分析",
          "sourceRefs": [
            "soy-source-lee2013"
          ],
          "sourceLocation": "Methods / Extraction; Tables 2–3",
          "actions": [
            {
              "id": "lee-sampling",
              "label": "取樣送到量測流程",
              "type": "handling",
              "explanation": "取樣和量測產生證據，不能當成新的發酵階段；來源未提供同批時間序列。",
              "sourceRefs": [
                "soy-source-lee2013"
              ]
            }
          ]
        }
      ]
    },
