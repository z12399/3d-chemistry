  "limits": [
    {
      "id": "nt-background",
      "rule": "NT代表未額外接種，不是無菌或無發酵。"
    },
    {
      "id": "method-scale",
      "rule": "只比較同一化合物、同一萃取法的四組訊號；跨萃取法不相加、不換算產率，跨化合物峰值不等於相同量或感官強度。"
    },
    {
      "id": "nd",
      "rule": "ND保留null，不是0；報到0.000的SD或均值也不證明恰為0。"
    },
    {
      "id": "repeats",
      "rule": "n=3和SD對應原文萃取重複；獨立發酵批次數未交代，不把它當3個獨立發酵。"
    },
    {
      "id": "letters",
      "rule": "保留刊載分組及8組註腳疑點；不自算p、不宣稱重新證實顯著性。"
    },
    {
      "id": "mechanism",
      "rule": "終點訊號差異不足以指定菌的唯一代謝路徑、抑制機制、菌量或通量。"
    },
    {
      "id": "causality",
      "rule": "四處理沒有讓發酵批次與背景菌量等所有比較前提自動成立；不把LY-NT當單一微生物純效應。"
    },
    {
      "id": "no-dynamics",
      "rule": "只有發酵 3 個月的終點，不插值成發酵時間歷程、底物消耗曲線或群落成長曲線。"
    },
    {
      "id": "no-sensory",
      "rule": "訊號大小不等於偏好、品質最佳或風味強度；本研究未做消费者感官評分。"
    },
    {
      "id": "no-salt-prediction",
      "rule": "四組均16%w/v鹽；不提供減鹽滑桿、保存期限或安全推定。"
    },
    {
      "id": "no-mass-balance",
      "rule": "缺原料／生物量／氣體／固液分配／各期庫存，不用GC相對峰面積補假碳氮收支。"
    },
    {
      "id": "study-specific-process",
      "rule": "大豆研究流程與一般含小麥醬油工藝分開；不能把未報的w/w比例、醪溫、壓榨殺菌參數填入此研究。"
    }
  ],
